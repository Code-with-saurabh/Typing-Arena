# ─── SERVER (backend) ────────────────────────────────────────────────
# Copy to server/.env and adjust. Local dev works with the defaults below.

# Port the HTTP server listens on. PaaS (Abasthan/Render) overrides via $PORT.
PORT=47819

# MongoDB connection string. Local default or Atlas in production.
MONGO_URI=mongodb://127.0.0.1:27017/typing_arena
# MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/typing_arena?appName=<app>

# production | development (unset = development)
# NODE_ENV=production

# Comma-separated origins allowed by CORS in production.
# Unset + same-origin serving = no CORS middleware (recommended when
# the API and client are served by this same server).
# ALLOWED_ORIGINS=https://your-domain.com

# Set to 1 when running behind a reverse proxy (always set on PaaS)
# so rate limiting keys on real client IPs (X-Forwarded-For).
# TRUST_PROXY=1

# Rate limits (per client IP). Defaults shown; override only if needed.
# API_RATE_LIMIT_WINDOW_MS=60000
# API_RATE_LIMIT_MAX=300
# SCORE_RATE_LIMIT_WINDOW_MS=60000
# SCORE_RATE_LIMIT_MAX=30

# Anti-sleep keep-alive: self-ping /api/health + MongoDB ping every N ms
# (default 300000 = 5 min, keeps the service active; 0 disables).
# KEEPALIVE_INTERVAL_MS=300000

# ─── CLIENT (frontend) ───────────────────────────────────────────────
# None required — the client talks to /api and io('/') on the same origin.
# Only introduce VITE_* vars if the API ever moves to another domain.
