# ── CLIENT (Vite build-time vars — only VITE_* prefixed are exposed) ──

# API / Socket.IO base URL.
# Empty = same origin → dev uses the Vite proxy (/api, /socket.io → :47819),
# production build talks to the same server that serves the bundle.
# Set ONLY if the API is hosted on a different origin:
# VITE_API_URL=http://localhost:47819
VITE_API_URL=
